rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // User progress subcollection
      match /progress/{moduleId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(moduleId);
        allow delete: if isOwner(userId);
      }

      // User activities subcollection
      match /activities/{activityId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(activityId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
